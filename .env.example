# DeepSeek：不配置时健康检查和本地预测仍可启动，聊天功能会提示未配置。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 通用OpenAI兼容配置。填写后优先于上面的DeepSeek兼容变量。
# 阿里云百炼：LLM_PROVIDER=aliyun-bailian
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_DEFAULT_MODEL=qwen-plus
# 豆包方舟：LLM_PROVIDER=doubao
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_DEFAULT_MODEL填写方舟推理接入点ID（通常以ep-开头）。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
LLM_DEFAULT_MODEL=deepseek-chat
LLM_MODEL_NAME=DeepSeek Chat
LLM_MODELS=
LLM_REASONING_MODELS=deepseek-reasoner

# MCP服务
MCP_SERVER_URL=http://127.0.0.1:12346/sse
MCP_DEBUG=false

# 模型与知识库路径。相对路径均以项目根目录为准。
MODEL_DIR=models/solar
PSKNA_DIR=models/perovskite_narrow
PSKWD_DIR=models/perovskite_wide
EMBEDDING_DIR=embedding
RAG_BACKEND=auto
RAG_LEXICAL_MIN_SCORE=0.05
OUTPUT_DIR=outputs
RAG_CHUNK_CHARACTERS=600
RAG_CHUNK_OVERLAP=80
RAG_DENSE_WEIGHT=0.8
MCP_TOOL_TIMEOUT_SECONDS=30
MCP_TOOL_MAX_ATTEMPTS=3
MCP_TOOL_RETRY_BASE_SECONDS=0.25
MCP_TOOL_ALLOWLIST=
MAX_TOOL_ROUNDS=4

# Gradio前端
SOLAR_API_HOST=127.0.0.1
SOLAR_API_PORT=8001
SOLAR_API_BASE_URL=http://127.0.0.1:8001/api
SOLAR_UI_HOST=127.0.0.1
SOLAR_UI_PORT=5173

# 跨会话显式记忆与工具语义路由。路径留空时不自动下载模型。
SOLAR_STATE_DB=data/state.sqlite3
SOLAR_MEMORY_NAMESPACE=local
SOLAR_ENCODER_PATH=
# multilingual-e5-small 使用 e5；MiniLM 等对称模型使用 symmetric。
SOLAR_ENCODER_PROFILE=symmetric
# all / lexical / semantic；semantic 必须设置本地 encoder 路径。
SOLAR_TOOL_ROUTING=all
LLM_MAX_CONTEXT_CHARS=64000
LLM_STREAM_USAGE=true
# 本地 CPU 启动器会覆盖为安全预算；通用服务可按模型上下文调整。
LLM_MAX_OUTPUT_TOKENS=2048
# OpenAI 兼容请求的自动重试次数，设为 0 可避免本地 CPU 请求重复等待。
LLM_MAX_RETRIES=1
# full 保留完整工具说明；summary 只发首行描述，但保留完整参数 schema。
SOLAR_TOOL_DESCRIPTIONS=full
SOLAR_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 公开 TOPCon 代理模型训练产物（可选，不能替代原三组 AutoGluon 权重）。
TOPCON_PUBLIC_MODEL_DIR=

# 可观测性：仅在显式设置后向该 Collector 发送无正文的 spans。
# 需先安装 requirements-observability.txt。
SOLAR_OTLP_ENDPOINT=

# 已有 Qwen / LoRA / encoder 的统一启动参见 docs/INTEGRATED_WORKFLOWS.md。
# 统一启动器通过子进程环境覆盖端口和状态位置，不修改此文件或本机 .env。
